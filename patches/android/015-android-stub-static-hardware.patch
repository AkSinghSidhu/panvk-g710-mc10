From: panvk-kbase-android worker <panvk-worker@localhost>
Subject: [PATCH android 015] android-stub: static hardware stub, -ENOENT from hw_get_module

Purpose: make the Android stub's hw_get_module() tell the truth. The old
 stub returned 0 and left *module untouched, so u_gralloc_fallback_create()
 read that as "gralloc hwmodule found" and dereferenced the (still null)
 module. Return -ENOENT with *module = NULL so discovery takes the fallback
 path it is meant to take ("No gralloc hwmodule detected (video buffers
 won't be supported)").

The stub also stops pretending to be a HAL shared library: compile
 hardware_stub.cpp as a static library linked into the ICD, so the symbol
 is always resolved in-process and the ICD carries no runtime libhardware
 dependency (DT_NEEDED of the built ICD: liblog, libnativewindow, libsync,
 libm, libz, libdl, libc).

diff --git a/src/android_stub/hardware_stub.cpp b/src/android_stub/hardware_stub.cpp
index 4cb973fd2ac..b20f8de9ccc 100644
--- a/src/android_stub/hardware_stub.cpp
+++ b/src/android_stub/hardware_stub.cpp
@@ -1,10 +1,13 @@
 #include <hardware/hardware.h>
+#include <errno.h>
 
 extern "C" {
 
 int hw_get_module(const char *id, const struct hw_module_t **module)
 {
-   return 0;
+   if (module)
+      *module = nullptr;
+   return -ENOENT;
 }
 
 }
diff --git a/src/android_stub/meson.build b/src/android_stub/meson.build
index 0e3f27bc4a5..3d659491e5b 100644
--- a/src/android_stub/meson.build
+++ b/src/android_stub/meson.build
@@ -1,6 +1,6 @@
 if with_android_stub
   stub_libs = []
-  lib_names = ['hardware', 'log', 'nativewindow', 'sync']
+  lib_names = ['log', 'nativewindow', 'sync']
 
   if with_libbacktrace
     lib_names += ['backtrace']
@@ -15,7 +15,16 @@ if with_android_stub
     )
   endforeach
 
+  stub_static_libs = [
+    static_library(
+      'hardware',
+      files('hardware_stub.cpp'),
+      include_directories : inc_include,
+      install : false,
+    )
+  ]
+
   dep_android = declare_dependency(
-    link_with : stub_libs,
+    link_with : stub_libs + stub_static_libs,
   )
 endif
